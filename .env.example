# Server-only. Do not commit real values. Copy to .env for `pnpm dev`.
# Production secrets belong in `wrangler secret put`, not in this file.

# Notion published-writing source. Leave blank to fail open as "not configured".
NOTION_API_KEY=
NOTION_BLOG_DB_ID=
# fixture | unavailable. Omit this to use Notion when the two values above are set.
WRITING_SOURCE=

# Existing Field Journal database. Do not create a new one.
# Share that database with the integration that owns NOTION_API_KEY.
# fixture | unavailable. Omit this to use Notion when the key and database id are set.
# Production ignores fixture and reports the journal unavailable.
NOTION_CARRIER_JOURNAL_DB_ID=
JOURNAL_SOURCE=

# Cloudflare Turnstile. Production fails closed when the secret is missing.
# Test keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare CONTACT_EMAIL binding in wrangler.jsonc.
# Use a plain sender address on an onboarded domain and a verified destination.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Set to mock only for local development. Production ignores it and fails closed.
CONTACT_EMAIL_ADAPTER=

# Weather lookup for the terminal. Leave blank and the command says it is not configured.
OPENWEATHER_API_KEY=

# λlambda. Either key enables the model. With neither, chat answers from the public site brief.
GROQ_API_KEY=
OPENAI_API_KEY=
GROQ_MODEL=
OPENAI_MODEL=
