# Server-only. Do not commit real values. Copy to .env for `pnpm dev`.
# Production secrets belong in `wrangler secret put`, not in this file.

# Notion published-writing source. Leave blank to fail open as "not configured".
NOTION_API_KEY=
NOTION_BLOG_DB_ID=
# fixture | unavailable. Omit this to use Notion when the two values above are set.
WRITING_SOURCE=

# Cloudflare Turnstile. Production fails closed when the secret is missing.
# Test keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend HTTP API. Preferred Worker-compatible sender.
# https://developers.cloudflare.com/workers/tutorials/send-emails-with-resend/
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Set to mock only for local development. Production ignores it and fails closed.
CONTACT_EMAIL_ADAPTER=
